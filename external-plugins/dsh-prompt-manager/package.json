{
  "name": "dsh-prompt-manager",
  "version": "1.5.0",
  "description": "A local, bilingual prompt library with session-level system prompt injection for DeepSeek Harness Web.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "SaiSenBox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaiSenBox/dsh-prompt-manager.git"
  },
  "homepage": "https://github.com/SaiSenBox/dsh-prompt-manager#readme",
  "bugs": {
    "url": "https://github.com/SaiSenBox/dsh-prompt-manager/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt-manager",
    "prompt-library"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node ../build.mjs dsh-prompt-manager"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "dependencies": {}
}
