# DeepSeek Harness Enterprise Environment Configuration
# Copy this file to .env.enterprise.local and fill in your values

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dsh_enterprise
DB_USER=dsh_admin
DB_PASSWORD=dsh_dev_password_change_me
DB_SSL=false
DB_MAX_CONNECTIONS=20

# ============================================================================
# Redis Configuration (Cache & Session)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dsh_redis_dev_password
REDIS_DB=0

# ============================================================================
# JWT Configuration
# ============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============================================================================
# DeepSeek API (for AI features)
# ============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================================================
# pgAdmin Configuration (optional)
# ============================================================================
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=admin

# ============================================================================
# Development Tools
# ============================================================================
# Enable debug mode
DEBUG=dsh:*

# Skip database migrations on startup (for testing)
# SKIP_MIGRATIONS=true
