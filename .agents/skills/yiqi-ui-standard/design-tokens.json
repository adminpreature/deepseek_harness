{
  "meta": {
    "name": "OneSeven Design Tokens",
    "version": "2.0.0",
    "brand": "17 RESEARCH INSTITUTE",
    "principle": "Dark-first shared visual boundaries with product-calibrated layout and density"
  },
  "theme": {
    "default": "dark",
    "lightGeneratedOnlyWhenRequested": true
  },
  "darkColors": {
    "page": "#09090B",
    "surface": "#141418",
    "surfaceElevated": "#1B1B20",
    "subtle": "#222228",
    "border": "#2E2E35",
    "borderStrong": "#44444D",
    "textPrimary": "#F5F5F7",
    "textSecondary": "#B8B8C0",
    "textTertiary": "#81818A"
  },
  "colors": {
    "primary": {
      "100": "#F3ECF7",
      "500": "#9A6ABA",
      "700": "#68447F"
    },
    "success": {
      "100": "#E7F2EC",
      "500": "#327A5B",
      "700": "#21513D"
    },
    "danger": {
      "100": "#F8E8EB",
      "500": "#B94A5A",
      "700": "#7D303B"
    },
    "neutral": {
      "50": "#FAFAFA",
      "100": "#F5F5F5",
      "200": "#E5E5E5",
      "400": "#A3A3A3",
      "700": "#525252",
      "900": "#171717"
    },
    "common": {
      "white": "#FFFFFF",
      "black": "#000000"
    }
  },
  "semanticColors": {
    "text": {
      "primary": "{darkColors.textPrimary}",
      "secondary": "{darkColors.textSecondary}",
      "tertiary": "{darkColors.textTertiary}",
      "inverse": "{colors.common.white}",
      "onAccent": "{darkColors.page}",
      "brand": "{colors.primary.500}",
      "success": "#72B596",
      "danger": "#DF7B89"
    },
    "background": {
      "page": "{darkColors.page}",
      "surface": "{darkColors.surface}",
      "elevated": "{darkColors.surfaceElevated}",
      "subtle": "{darkColors.subtle}",
      "selected": "rgba(154, 106, 186, 0.16)",
      "success": "rgba(50, 122, 91, 0.18)",
      "danger": "rgba(185, 74, 90, 0.18)"
    },
    "border": {
      "default": "{darkColors.border}",
      "strong": "{darkColors.borderStrong}",
      "focus": "{colors.primary.500}",
      "focusRing": "rgba(154, 106, 186, 0.28)",
      "success": "{colors.success.500}",
      "danger": "{colors.danger.500}"
    },
    "status": {
      "info": {
        "background": "rgba(154, 106, 186, 0.16)",
        "foreground": "#D7BCE8"
      },
      "warning": {
        "background": "{darkColors.subtle}",
        "foreground": "{darkColors.textPrimary}",
        "icon": "{colors.primary.500}"
      },
      "success": {
        "background": "rgba(50, 122, 91, 0.18)",
        "foreground": "#72B596"
      },
      "danger": {
        "background": "rgba(185, 74, 90, 0.18)",
        "foreground": "#DF7B89"
      }
    }
  },
  "typography": {
    "fontAssets": [
      {
        "family": "Alibaba PuHuiTi",
        "weight": 200,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-35-Thin.woff2"
      },
      {
        "family": "Alibaba PuHuiTi",
        "weight": 400,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-55-Regular.woff2"
      },
      {
        "family": "Alibaba PuHuiTi",
        "weight": 500,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-65-Medium.woff2"
      },
      {
        "family": "Alibaba PuHuiTi",
        "weight": 600,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-75-SemiBold.woff2"
      }
    ],
    "fontFamily": {
      "sans": [
        "Alibaba PuHuiTi",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "mono": [
        "SF Mono",
        "Consolas",
        "Menlo",
        "Monaco",
        "Courier New",
        "monospace"
      ]
    },
    "fontWeight": {
      "brand": 200,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "42px"
    },
    "lineHeight": {
      "xs": "16px",
      "sm": "20px",
      "base": "24px",
      "lg": "28px",
      "xl": "28px",
      "2xl": "32px",
      "3xl": "36px",
      "4xl": "40px",
      "5xl": "48px"
    },
    "roles": {
      "marketingH1": {
        "desktop": {
          "min": "36px",
          "max": "42px"
        },
        "mobile": {
          "min": "30px",
          "max": "36px"
        }
      },
      "pageTitle": {
        "desktop": {
          "min": "28px",
          "max": "32px"
        },
        "mobile": {
          "min": "24px",
          "max": "28px"
        }
      },
      "sectionTitle": {
        "desktop": {
          "min": "22px",
          "max": "24px"
        },
        "mobile": {
          "min": "20px",
          "max": "22px"
        }
      },
      "cardTitle": {
        "desktop": {
          "min": "16px",
          "max": "20px"
        },
        "mobile": {
          "min": "16px",
          "max": "18px"
        }
      },
      "saasPageTitle": {
        "min": "20px",
        "max": "24px"
      },
      "saasPanelTitle": {
        "min": "16px",
        "max": "18px"
      },
      "saasBody": {
        "min": "13px",
        "max": "16px"
      }
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "density": {
    "compact": {
      "controlHeight": "32px",
      "componentPaddingInline": "12px",
      "componentPaddingBlock": "8px",
      "componentGap": "12px",
      "gridGap": "16px"
    },
    "standard": {
      "controlHeight": "40px",
      "componentPaddingInline": "16px",
      "componentPaddingBlock": "12px",
      "componentGap": "16px",
      "gridGap": "24px"
    },
    "spacious": {
      "controlHeight": "48px",
      "componentPaddingInline": "24px",
      "componentPaddingBlock": "16px",
      "componentGap": "24px",
      "gridGap": "32px"
    }
  },
  "borderRadius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "card": "36px",
    "cardMobile": {
      "min": "28px",
      "default": "32px",
      "max": "36px"
    },
    "full": "9999px"
  },
  "cardMaterials": {
    "defaultQuestionRequired": true,
    "solid": {
      "background": "{darkColors.surface}",
      "border": "{darkColors.border}",
      "shadow": "0 18px 60px rgba(0, 0, 0, 0.22)"
    },
    "liquidGlass": {
      "background": "rgba(255, 255, 255, 0.08)",
      "border": "rgba(255, 255, 255, 0.16)",
      "backdropBlur": "24px",
      "backdropSaturation": "140%",
      "reducedTransparencyFallback": "{cardMaterials.solid}",
      "unsupportedBackdropFallback": "{cardMaterials.solid}",
      "fallbackOverrides": {
        "backdropFilter": "none"
      }
    }
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.08)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.12)"
  },
  "motion": {
    "duration": {
      "fast": "200ms",
      "base": "300ms",
      "slow": "500ms",
      "slower": "600ms",
      "reduced": "120ms"
    },
    "easing": {
      "outQuick": "cubic-bezier(0.23, 1, 0.32, 1)",
      "outSmooth": "cubic-bezier(0.32, 0.72, 0, 1)",
      "outBounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "inSmooth": "cubic-bezier(0.32, 0, 0.67, 0)",
      "inOut": "cubic-bezier(0.77, 0, 0.175, 1)"
    },
    "spring": {
      "defaultBounce": 0,
      "spatialBounce": 0.1,
      "button": {
        "duration": 0.2,
        "bounce": 0
      },
      "menu": {
        "duration": 0.3,
        "bounce": 0
      },
      "modal": {
        "duration": 0.5,
        "bounce": 0.1
      },
      "drawer": {
        "duration": 0.6,
        "bounce": 0.1
      },
      "page": {
        "duration": 0.5,
        "bounce": 0
      }
    },
    "loading": {
      "spinnerPeriod": "900ms",
      "skeletonPeriod": "1600ms",
      "progressTransition": "300ms"
    }
  },
  "zIndex": {
    "base": 0,
    "dropdown": 1000,
    "sticky": 1100,
    "overlay": 1200,
    "modal": 1300,
    "popover": 1400,
    "toast": 1500
  }
}
