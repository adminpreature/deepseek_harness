{
  "name": "@deepseek-ai/dsh-tenant",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant infrastructure for DeepSeek Harness Enterprise",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    }
  },
  "files": [
    "lib",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "deepseek",
    "harness",
    "enterprise",
    "multi-tenant",
    "saas"
  ],
  "author": "DeepSeek AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/enterprise/tenant"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "pg": "^8.11.3",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "vitest": "^1.0.0",
    "typescript": "^5.3.0"
  }
}
